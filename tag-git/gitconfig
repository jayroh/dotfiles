# Credit where credit is due - thank you @gabebw:
# https://github.com/gabebw/dotfiles/blob/master/tag-git/gitconfig

[user]
  email = joel.oliveira@gmail.com
  name = Joel Oliveira
[github]
  user = jayroh
[core]
  editor = nvim
  whitespace = trailing-space,cr-at-eol
  excludesfile = ~/.gitignore
  autocrlf = false
[merge]
  # Per @jferris: `ff = only` means Git will never implicitly do a merge
  # commit, including while doing git pull. If I'm unexpectedly out of sync
  # when I git pull, I get this message: fatal: Not possible to fast-forward,
  # aborting.  At that point, I know that I've forgotten to do something in my
  # normal workflow, and I retrace my steps.
  ff = only
[diff]
  # Git diff will use (i)ndex, (w)ork tree, (c)ommit and (o)bject instead of
  # a/b/c/d as prefixes for patches
  mnemonicprefix = true
  # Turn on an experimental heuristic that should make the diff easier to read
  compactionHeuristic = true
[alias]
  a = add
  ci = commit -v
  d = diff
  dif = diff
  l = log --graph --pretty=format:'%Cred%h%Creset %an: %s - %Creset %C(yellow)%d%Creset %Cgreen(%cr)%Creset' --abbrev-commit --date=relative
  lo = log -1 --pretty='%C(red)%H%nAuthor: %C(green)%an%n%C(magenta)%s%n%b'
  ls = branch -a
  circle = !gh pr checks
  open = !gh browse
  pr = !gh pr create --fill
  rebae = rebase
  rebasse = rebase
  rubocop = "!git status --porcelain | cut -c4- | grep '.rb' | xargs bundle exec rubocop"
  s = status --short --branch
  spec = "!bundle exec rspec `git ls-files --modified --others spec | grep _spec`"
  unstage = reset
  wip = !git add . && git commit -m '[ci skip] WIP'

  # Typos
  puhs = push
  pul = pull
  pus = push
  brnach = branch
[push]
  default = simple
  autoSetupRemote = true
[diff]
  compactionHeuristic = true
[init]
  defaultBranch = main
# Authenticate HTTPS pushes/fetches with the gh token instead of a PAT.
# `gh auth setup-git` writes an absolute path here; kept PATH-relative so it
# also resolves on Linux, where gh is /usr/bin/gh rather than /opt/homebrew/bin.
# The empty `helper =` line resets any inherited helper -- gh's own convention.
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential

# TEMPORARY -- added on airplane wifi, which accepts TCP on any port but only
# passes real traffic for HTTP/HTTPS, so SSH hangs during banner exchange on
# both 22 and ssh.github.com:443. Rewrites github SSH remotes to HTTPS without
# touching any repo's stored remote. Remove once back on a normal network:
#   git config --global --unset url."https://github.com/".insteadOf
[url "https://github.com/"]
	insteadOf = git@github.com:

# Machine-local overrides, never committed -- same idea as ~/.zshrc_private.
# Last include wins, so anything here overrides the settings above. Note that
# `git config --global` still writes to THIS file (~/.gitconfig is a symlink
# into the dotfiles repo), so machine-specific tweaks belong in the local file.
[include]
	path = ~/.gitconfig_local
