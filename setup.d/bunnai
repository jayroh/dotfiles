#!/bin/bash
# Install bunnai (AI commit-message helper for lazygit) globally via bun.
set -e

# Call bun via mise's install path directly rather than relying on PATH —
# this script runs standalone from ./setup, outside any shell that has run
# `mise activate`, so a bare `bun`/`command -v bun` can't see it yet.
# mise repoints the "latest" symlink itself on every bun upgrade, so this
# stays correct without edits.
BUN="$HOME/.local/share/mise/installs/bun/latest/bin/bun"

if [[ ! -x "$BUN" ]]; then
  echo "⚠️  bun not found at $BUN. Run setup.d/mise first."
  exit 1
fi

"$BUN" install -g @chhoumann/bunnai
echo "⚠️  Now configure bunnai with: bunnai config"
