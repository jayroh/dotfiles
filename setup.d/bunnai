#!/bin/bash
# Install bunnai (AI commit-message helper for lazygit) globally via bun.
set -e

# Resolve bun without relying on PATH — this script runs standalone from
# ./setup, outside any shell that has run `mise activate` / sourced asdf.
# Prefer mise's install path (mise repoints "latest" itself on upgrades), then
# asdf's shim dir (asdf takes precedence on machines that have ~/.asdf).
BUN=""
for candidate in "$HOME/.local/share/mise/installs/bun/latest/bin/bun" "$HOME/.asdf/shims/bun"; do
  if [[ -x "$candidate" ]]; then BUN="$candidate"; break; fi
done
if [[ -z "$BUN" ]]; then BUN="$(command -v bun || true)"; fi

if [[ -z "$BUN" ]]; then
  echo "⚠️  bun not found (mise or asdf). Run setup.d/mise first, or run: asdf install bun"
  exit 1
fi

"$BUN" install -g @chhoumann/bunnai
echo "⚠️  Now configure bunnai with: bunnai config"
