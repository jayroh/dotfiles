# source private zshrc file not kept in source control
[[ -f ~/.zshrc_private ]] && source ~/.zshrc_private

# source the base zshrc configurations first
# (N-.) = don't error on no matches, follow symlinks, regular files only — so a
# symlink left dangling by a renamed/removed fragment is skipped, not sourced.
for config_file (~/.config/zsh/*.zsh(N-.)) source $config_file

[ -s "$HOMEBREW_HOME/nvm/nvm.sh" ]                    && . "$HOMEBREW_HOME/nvm/nvm.sh"
[ -s "$HOMEBREW_HOME/nvm/etc/bash_completion.d/nvm" ] && . "$HOMEBREW_HOME/nvm/etc/bash_completion.d/nvm"

# push these paths to the front/top
path=(
	"./.git/safe/../../bin"
	"./.git/safe/../../bin/stubs"
	$path
)
fpath+=(
	$HOME/.zsh/pure
)

# vim mode in zsh
bindkey -v

eval "$(direnv hook zsh)"

# start up pure
autoload -U promptinit; promptinit
prompt pure
